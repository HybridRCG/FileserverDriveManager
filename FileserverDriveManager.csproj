<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>FileserverDriveManager</AssemblyName>
    <RootNamespace>FileserverDriveManager</RootNamespace>
    <Version>7.5.30</Version>
    <FileVersion>7.5.30.0</FileVersion>
    <AssemblyVersion>7.5.30.0</AssemblyVersion>
    <Company>Dyna Training</Company>
    <Product>Fileserver Drive Manager</Product>

    <!-- Single-file publishing settings.
         SelfContained and RuntimeIdentifier are intentionally NOT here.
         They are passed on the CLI so the workflow has full control and
         so IDEs don't auto-publish framework-dependent debug builds. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>

    <ApplicationIcon Condition="Exists('icon.ico')">icon.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);IL3000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Explicit include: MSBuild's default **/*.cs glob was silently missing
         Program.cs when building against the SMB-mounted Y:\ share (Mac -> VM
         dev loop) - likely a directory-enumeration quirk over the network
         mount, not an exclusion rule. Explicit Include guarantees it's always
         compiled regardless of glob timing. -->
    <Compile Remove="Program.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- archive/ holds old dated backups of Program.cs (see archive-before-build.sh).
         It's gitignored, so a fresh CI checkout never sees it - but on a local
         working copy every backup .cs file in there was being compiled alongside
         the real Program.cs, causing duplicate class / entry-point errors. -->
    <Compile Remove="archive/**/*.cs" />
    <Compile Remove="Program_*.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="logo.png" Condition="Exists('logo.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="icon.png" Condition="Exists('icon.png')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
